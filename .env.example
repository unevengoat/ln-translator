# Copy to .env for local dev (NEVER commit .env — keys stay out of git).
# Only set the providers you use; the "auto" chain tries them in order
# groq → gemini → openrouter → pollinations → free MT, skipping unset keys.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
# POLLINATIONS_API_KEY=   # optional — Pollinations works without a key

# Legacy single-provider overrides (used when --provider custom / no chain):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Web server (Render sets PORT automatically)
PORT=3000
